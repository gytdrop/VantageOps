<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================================================== -->
    <!-- PRODUCT VIEWS                                        -->
    <!-- ==================================================== -->
    <record id="view_dealflow_product_tree" model="ir.ui.view">
        <field name="name">dealflow.product.tree</field>
        <field name="model">dealflow.product</field>
        <field name="arch" type="xml">
            <tree string="DealFlow Products">
                <field name="name"/>
                <field name="category_type"/>
                <field name="list_price"/>
                <field name="standard_price"/>
                <field name="max_discount"/>
            </tree>
        </field>
    </record>

    <record id="view_dealflow_product_form" model="ir.ui.view">
        <field name="name">dealflow.product.form</field>
        <field name="model">dealflow.product</field>
        <field name="arch" type="xml">
            <form string="DealFlow Product">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Enterprise Server or Annual SaaS"/>
                        </h1>
                    </div>
                    <group>
                        <group name="pricing" string="Pricing &amp; Cost">
                            <field name="category_type"/>
                            <field name="list_price"/>
                            <field name="standard_price"/>
                        </group>
                        <group name="policy" string="Policy">
                            <field name="max_discount"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================================================== -->
    <!-- QUOTATION VIEWS                                      -->
    <!-- ==================================================== -->
    <record id="view_dealflow_quote_tree" model="ir.ui.view">
        <field name="name">dealflow.quote.tree</field>
        <field name="model">dealflow.quote</field>
        <field name="arch" type="xml">
            <tree string="Quotations">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="partner_tier"/>
                <field name="user_id"/>
                <field name="date_order"/>
                <field name="amount_total"/>
                <field name="order_margin_percent"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state in ('pending_manager', 'pending_finance', 'under_negotiation')" 
                       decoration-success="state in ('approved', 'confirmed', 'done')" 
                       decoration-danger="state == 'rejected'"/>
            </tree>
        </field>
    </record>

    <record id="view_dealflow_quote_kanban" model="ir.ui.view">
        <field name="name">dealflow.quote.kanban</field>
        <field name="model">dealflow.quote</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_name"/>
                <field name="partner_tier"/>
                <field name="amount_total"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <br/>
                                    <small class="text-muted"><field name="partner_name"/> (<field name="partner_tier"/>)</small>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge bg-primary"><field name="amount_total"/></span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection" 
                                           options="{'classes': {'draft': 'info', 'pending_manager': 'warning', 'pending_finance': 'warning', 'approved': 'success', 'confirmed': 'success', 'done': 'success', 'rejected': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dealflow_quote_form" model="ir.ui.view">
        <field name="name">dealflow.quote.form</field>
        <field name="model">dealflow.quote</field>
        <field name="arch" type="xml">
            <form string="DealFlow Quotation">
                <header>
                    <button name="action_confirm_deal" string="Confirm Order" type="object" class="oe_highlight" 
                            invisible="state not in ('draft', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_manager,approved,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info" string="Customer Details">
                            <field name="partner_name"/>
                            <field name="partner_email"/>
                            <field name="partner_tier"/>
                        </group>
                        <group name="deal_info" string="Deal Details">
                            <field name="user_id"/>
                            <field name="date_order"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="order_lines" string="Order Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="category_type"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="cost_price"/>
                                    <field name="discount"/>
                                    <field name="price_subtotal"/>
                                    <field name="margin"/>
                                    <field name="margin_percent"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed"/>
                                <field name="amount_discount"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="order_margin"/>
                                <field name="order_margin_percent"/>
                            </group>
                        </page>
                        <page name="notes_page" string="Terms &amp; Notes">
                            <field name="notes" placeholder="Internal remarks, customer notes, or delivery terms..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================================================== -->
    <!-- ACTIONS & MENUS                                      -->
    <!-- ==================================================== -->
    <record id="action_dealflow_quote" model="ir.actions.act_window">
        <field name="name">Quotations &amp; Orders</field>
        <field name="res_model">dealflow.quote</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new DealFlow Quotation</p>
        </field>
    </record>

    <record id="action_dealflow_pipeline" model="ir.actions.act_window">
        <field name="name">Deal Pipeline</field>
        <field name="res_model">dealflow.quote</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="action_dealflow_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">dealflow.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Top Navigation Root -->
    <menuitem id="menu_dealflow_root" name="DealFlow360" sequence="10"/>

    <!-- Quotations Menu -->
    <menuitem id="menu_dealflow_quote" name="Quotations" parent="menu_dealflow_root" action="action_dealflow_quote" sequence="10"/>
    <menuitem id="menu_dealflow_pipeline" name="Pipeline" parent="menu_dealflow_root" action="action_dealflow_pipeline" sequence="20"/>
    <menuitem id="menu_dealflow_product" name="Products" parent="menu_dealflow_root" action="action_dealflow_product" sequence="30"/>
    <menuitem id="menu_dealflow_config" name="Configuration" parent="menu_dealflow_root" sequence="90"/>

    <!-- Legacy / Boilerplate Hackathon Item View & Actions -->
    <record id="view_hackathon_item_tree" model="ir.ui.view">
        <field name="name">hackathon.item.tree</field>
        <field name="model">hackathon.item</field>
        <field name="arch" type="xml">
            <tree string="Hackathon Items">
                <field name="name"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_hackathon_item_form" model="ir.ui.view">
        <field name="name">hackathon.item.form</field>
        <field name="model">hackathon.item</field>
        <field name="arch" type="xml">
            <form string="Hackathon Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hackathon_item" model="ir.actions.act_window">
        <field name="name">Hackathon Items</field>
        <field name="res_model">hackathon.item</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
