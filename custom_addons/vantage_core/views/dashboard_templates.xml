<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="vantage_sales_dashboard_template">
        <div class="o_vantage_dashboard p-4" style="background-color: #f8fafc; min-height: 100vh; color: #0f172a; font-family: system-ui, -apple-system, sans-serif;">
            
            <!-- Top Executive Header -->
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid #e2e8f0;">
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center justify-content-center rounded-3 shadow-sm text-white" 
                         style="width: 48px; height: 48px; background: #714B67;">
                        <i class="fa fa-tachometer fs-4 text-white" title="Control Center"/>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="fw-bold mb-0" style="color: #0f172a !important; letter-spacing: -0.5px;">VantageOps Control Center</h4>
                            <span class="badge rounded px-2 py-1 text-white fw-bold" style="background-color: #714B67 !important; font-size: 0.7rem;">COMMAND CENTER</span>
                        </div>
                        <div class="small fw-semibold mt-1" style="color: #475569 !important;">
                            Autonomous Deal Governance, Margin Guardrails &amp; N-Way Multi-Depot Logistics
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm fw-bold shadow-sm vantage-btn-approvals" type="object" name="action_view_approvals"
                            style="background: #ffffff !important; color: #0f172a !important; border: 1px solid #94a3b8 !important;">
                        <i class="fa fa-tasks me-1 text-primary" title="Approvals Queue"/> <span style="color: #0f172a !important;">Approvals Queue</span>
                    </button>
                    <!-- Visible High-Contrast Purple Button -->
                    <button class="btn btn-sm fw-bold shadow-sm text-white vantage-btn-new-quote" type="object" name="action_new_quotation"
                            style="background-color: #714B67 !important; background: #714B67 !important; border: 1px solid #5B3D53 !important; color: #ffffff !important;">
                        <i class="fa fa-plus me-1 text-white" title="New Quotation"/> <span style="color: #ffffff !important;">New Quotation</span>
                    </button>
                </div>
            </div>

            <!-- Row 1: KPI Stat Cards -->
            <div class="row g-3 mb-4">
                <!-- Pending Approvals -->
                <div class="col-md-3">
                    <div class="card p-3 h-100" style="border-left: 5px solid #d97706 !important;">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-label">Pending Approvals</span>
                            <i class="fa fa-clock-o text-warning fs-5" title="Pending Approvals"/>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <h2 class="kpi-value mb-0">7</h2>
                        </div>
                        <div class="kpi-subtext mt-1">Requires dual sign-off</div>
                    </div>
                </div>

                <!-- At-Risk Deals -->
                <div class="col-md-3">
                    <div class="card p-3 h-100" style="border-left: 5px solid #dc2626 !important;">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-label">At-Risk Deals</span>
                            <i class="fa fa-shield text-danger fs-5" title="At-Risk Deals"/>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <h2 class="kpi-value kpi-danger mb-0">13</h2>
                        </div>
                        <div class="kpi-subtext mt-1 text-danger">Exceeding margin floor</div>
                    </div>
                </div>

                <!-- Active Deals -->
                <div class="col-md-3">
                    <div class="card p-3 h-100" style="border-left: 5px solid #0284c7 !important;">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-label">Active Deals</span>
                            <i class="fa fa-folder-open text-info fs-5" title="Active Deals"/>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <h2 class="kpi-value mb-0">23</h2>
                        </div>
                        <div class="kpi-subtext mt-1">Across all client tiers</div>
                    </div>
                </div>

                <!-- Auto-Split Dispatches -->
                <div class="col-md-3">
                    <div class="card p-3 h-100" style="border-left: 5px solid #059669 !important;">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-label">Auto-Split Dispatches</span>
                            <i class="fa fa-truck text-success fs-5" title="Auto-Split Dispatches"/>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mt-2">
                            <h2 class="kpi-value kpi-success mb-0">94.2%</h2>
                        </div>
                        <div class="kpi-subtext mt-1">Zero backorder stall</div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Analytics & Live Stream Split -->
            <div class="row g-3 mb-4">
                <!-- Left Panel: Table -->
                <div class="col-md-7">
                    <div class="card p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-bold fs-6" style="color: #0f172a !important;">Fulfillment &amp; Governance Posture</span>
                                <span class="badge status-direct">Live Pipeline</span>
                            </div>
                            <span class="badge status-optimized">
                                ● Autonomous Interceptor Active
                            </span>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>TIER / CATEGORY</th>
                                        <th class="text-center">ACTIVE VOLUME</th>
                                        <th class="text-center">INTERCEPTION RATE</th>
                                        <th class="text-end">FULFILLMENT STATUS</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span class="badge tier-bronze">Bronze Accounts</span>
                                        </td>
                                        <td class="text-center fw-bold">11 Deals</td>
                                        <td class="text-center fw-bold text-danger">45.5% (High Risk)</td>
                                        <td class="text-end">
                                            <span class="badge status-optimized">Optimized</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span class="badge tier-silver">Silver Accounts</span>
                                        </td>
                                        <td class="text-center fw-bold">8 Deals</td>
                                        <td class="text-center fw-bold" style="color: #b45309 !important;">12.5% (Moderate)</td>
                                        <td class="text-end">
                                            <span class="badge status-split">Multi-Depot Split</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <span class="badge tier-gold">Gold Enterprise</span>
                                        </td>
                                        <td class="text-center fw-bold">4 Deals</td>
                                        <td class="text-center fw-bold text-success">0.0% (Clean)</td>
                                        <td class="text-end">
                                            <span class="badge status-direct">Direct Allocation</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right Panel: Live Feed -->
                <div class="col-md-5">
                    <div class="card p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-bolt text-warning fs-5" title="Event Stream"/>
                                <span class="fw-bold fs-6" style="color: #0f172a !important;">Autonomous Event Stream</span>
                            </div>
                            <span class="badge status-optimized">Live Bus</span>
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="event-item" style="border-left-color: #dc2626 !important;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="event-id">S00019</span>
                                    <span class="badge" style="background: #fef2f2 !important; color: #dc2626 !important; border: 1px solid #fecaca !important;">Rejected</span>
                                </div>
                                <div class="event-desc mt-1">
                                    Excessive margin bleed detected (50% discount on Bronze). Halted by Governor.
                                </div>
                            </div>

                            <div class="event-item" style="border-left-color: #0284c7 !important;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="event-id">S00039</span>
                                    <span class="badge status-split">Fulfillment Split</span>
                                </div>
                                <div class="event-desc mt-1">
                                    Network deficit resolved: 2 line items routed to Secondary Depot.
                                </div>
                            </div>

                            <div class="event-item" style="border-left-color: #059669 !important;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="event-id">S00007</span>
                                    <span class="badge status-optimized">Dual-Approved</span>
                                </div>
                                <div class="event-desc mt-1">
                                    Commercial sign-off completed by Finance Director. Committed to dispatch.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 3: Depot Health Grid -->
            <div class="row g-3">
                <div class="col-12">
                    <div class="card p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid #e2e8f0;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-cubes text-secondary fs-5" title="Warehouse Matrix"/>
                                <span class="fw-bold fs-6" style="color: #0f172a !important;">Real-Time Warehouse Stock &amp; Depot Health Matrix</span>
                            </div>
                            <div class="d-flex gap-2">
                                <span class="badge status-direct">Dynamic Multi-Depot Mesh</span>
                                <span class="badge status-optimized">● Engine Online</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <!-- Depot 1 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark">San Francisco (WH/Stock)</span>
                                        <span class="badge status-optimized">Primary Depot</span>
                                    </div>
                                    <div class="depot-progress-track">
                                        <div class="depot-progress-fill primary" style="width: 82%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small mt-2">
                                        <span class="fw-bold" style="color: #475569 !important;">Available: <strong style="color: #0f172a !important;">1,420 units</strong></span>
                                        <span class="kpi-subtext">Capacity: 82%</span>
                                    </div>
                                    <div class="kpi-subtext mt-1" style="font-size: 0.75rem !important;">
                                        Route: Direct Pick &amp; Pack • Latency: &lt;1.2h
                                    </div>
                                </div>
                            </div>

                            <!-- Depot 2 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark">Chicago Regional (WH2/Stock)</span>
                                        <span class="badge status-split">Secondary Depot</span>
                                    </div>
                                    <div class="depot-progress-track">
                                        <div class="depot-progress-fill secondary" style="width: 64%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small mt-2">
                                        <span class="fw-bold" style="color: #475569 !important;">Available: <strong style="color: #0f172a !important;">680 units</strong></span>
                                        <span class="kpi-subtext">Capacity: 64%</span>
                                    </div>
                                    <div class="kpi-subtext mt-1" style="font-size: 0.75rem !important;">
                                        Route: N-Way Auto-Forking Active • Latency: &lt;2.4h
                                    </div>
                                </div>
                            </div>

                            <!-- Depot 3 -->
                            <div class="col-md-4">
                                <div class="p-3 rounded-3" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark">Austin Hub (WH3/Stock)</span>
                                        <span class="badge tier-bronze">Reserve Depot</span>
                                    </div>
                                    <div class="depot-progress-track">
                                        <div class="depot-progress-fill reserve" style="width: 38%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center small mt-2">
                                        <span class="fw-bold" style="color: #475569 !important;">Available: <strong style="color: #0f172a !important;">310 units</strong></span>
                                        <span class="kpi-subtext">Capacity: 38%</span>
                                    </div>
                                    <div class="kpi-subtext mt-1" style="font-size: 0.75rem !important;">
                                        Route: Cross-Dock Failover Ready • Latency: &lt;3.5h
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </template>
</odoo>