<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend DealFlow Quotation Form View -->
    <record id="view_dealflow_quote_form_inherit_feature_a" model="ir.ui.view">
        <field name="name">dealflow.quote.form.inherit.feature.a</field>
        <field name="model">dealflow.quote</field>
        <field name="inherit_id" ref="hackathon_core.view_dealflow_quote_form"/>
        <field name="arch" type="xml">
            <!-- Header Action Buttons -->
            <xpath expr="//header" position="inside">
                <button name="action_compute_blended_risk" string="Calculate Risk" type="object" class="btn-secondary"
                        invisible="state not in ('draft', 'under_negotiation')"/>
                <button name="action_submit_approval" string="Submit for Approval" type="object" class="btn-primary"
                        invisible="state not in ('draft', 'under_negotiation')"/>
                <button name="action_approve_manager" string="Manager Approve" type="object" class="btn-success"
                        invisible="state != 'pending_manager'"/>
                <button name="action_approve_finance" string="Finance Approve" type="object" class="btn-success"
                        invisible="state != 'pending_finance'"/>
                <button name="action_reject" string="Reject Deal" type="object" class="btn-danger"
                        invisible="state not in ('pending_manager', 'pending_finance')"/>
                <button name="action_generate_portal_link" string="Open Customer Portal" type="object" class="btn-info"
                        invisible="state in ('done', 'cancel', 'rejected')"/>
            </xpath>

            <!-- Sheet Header Alert Badges -->
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="alert alert-danger mb-2" role="alert" invisible="discount_anomaly == False">
                    <strong>⚠️ Discount Anomaly Detected:</strong> The discounts requested significantly exceed your historical deal average!
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="is_stalled == False">
                    <strong>⏳ Stalled Deal:</strong> This quotation has been inactive for <field name="days_inactive" readonly="1"/> days.
                </div>
            </xpath>

            <!-- Pages in Notebook -->
            <xpath expr="//notebook" position="inside">
                <page name="page_akthar_approvals" string="Risk &amp; Approvals">
                    <group>
                        <group string="Blended Risk Assessment">
                            <field name="blended_risk_score"/>
                            <field name="risk_level"/>
                            <field name="requires_manager_approval"/>
                            <field name="requires_finance_approval"/>
                        </group>
                        <group string="Approval Status">
                            <field name="approval_state"/>
                        </group>
                    </group>
                    <field name="approval_log_ids" readonly="1">
                        <tree string="Approval Audit Trail">
                            <field name="create_date" string="Date &amp; Time"/>
                            <field name="user_id" string="Actor"/>
                            <field name="action"/>
                            <field name="risk_score"/>
                            <field name="reason"/>
                        </tree>
                    </field>
                </page>

                <page name="page_akthar_deal_health" string="Deal Health &amp; Negotiation">
                    <group>
                        <group string="Deal Health Monitoring">
                            <field name="days_inactive"/>
                            <field name="is_stalled"/>
                            <field name="discount_anomaly"/>
                        </group>
                        <group string="Portal Negotiation Terms">
                            <field name="portal_token"/>
                            <field name="portal_counter_discount"/>
                            <field name="portal_counter_notes"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Discount Tier Tree View -->
    <record id="view_dealflow_discount_tier_tree" model="ir.ui.view">
        <field name="name">dealflow.discount.tier.tree</field>
        <field name="model">dealflow.discount.tier</field>
        <field name="arch" type="xml">
            <tree string="Discount Ceilings" editable="bottom">
                <field name="customer_tier"/>
                <field name="category_type"/>
                <field name="max_discount_allowed"/>
                <field name="manager_approval_threshold"/>
                <field name="finance_approval_threshold"/>
            </tree>
        </field>
    </record>

    <record id="action_dealflow_discount_tier" model="ir.actions.act_window">
        <field name="name">Discount Ceilings</field>
        <field name="res_model">dealflow.discount.tier</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu Item for Akthar's Configuration -->
    <menuitem id="menu_dealflow_discount_tier" name="Discount Ceilings" 
              parent="hackathon_core.menu_dealflow_config" 
              action="action_dealflow_discount_tier" sequence="10"/>

    <!-- Legacy / Shim View for hackathon.item -->
    <record id="view_hackathon_item_form_inherit_a" model="ir.ui.view">
        <field name="name">hackathon.item.form.inherit.a</field>
        <field name="model">hackathon.item</field>
        <field name="inherit_id" ref="hackathon_core.view_hackathon_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="feature_a_score"/>
            </xpath>
        </field>
    </record>
</odoo>
