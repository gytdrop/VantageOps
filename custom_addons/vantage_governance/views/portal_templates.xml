<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Task 2A: Sidebar Bargain / Negotiation Action Button -->
    <template id="sale_order_portal_template_inherit_vantage" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@id='sale_order_sidebar_button']" position="inside">
            <a t-if="sale_order.state in ('draft', 'sent')" 
               role="button" 
               class="btn btn-warning text-dark fw-bold d-block shadow-sm" 
               href="#deal_negotiation_portal">
                🤝 <t t-if="not sale_order.is_negotiation_locked">Bargain / Counter-Offer</t>
                   <t t-else="">Negotiation Status (Locked)</t>
            </a>
        </xpath>
    </template>

    <!-- Task 2B: Top-Level Deal Negotiation Portal Card -->
    <template id="sale_order_portal_content_inherit_vantage" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='informations']" position="before">
            <!-- Deal Negotiation Portal Card (Always Visible for Draft and Sent Deals) -->
            <div id="deal_negotiation_portal" class="card mb-4 border-warning shadow-sm" t-if="sale_order.state in ('draft', 'sent')">
                <div class="card-header bg-warning text-dark font-weight-bold d-flex justify-content-between align-items-center">
                    <span class="fs-6">🤝 Deal Negotiation &amp; Bargain Portal (Round <t t-esc="sale_order.negotiation_rounds + 1"/> of <t t-esc="sale_order.max_negotiation_rounds"/>)</span>
                    <t t-if="not sale_order.is_negotiation_locked">
                        <span class="badge bg-success text-white px-2 py-1">Negotiation Open</span>
                    </t>
                    <t t-else="">
                        <span class="badge bg-danger text-white px-2 py-1">Circuit Breaker Locked</span>
                    </t>
                </div>
                <div class="card-body">
                    <!-- Negotiation Session Feedback Alerts -->
                    <t t-if="request.session.get('portal_success')">
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            <i class="fa fa-check-circle me-2"/> <t t-esc="request.session.pop('portal_success')"/>
                        </div>
                    </t>
                    <t t-if="request.session.get('portal_error')">
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="fa fa-exclamation-triangle me-2"/> <t t-esc="request.session.pop('portal_error')"/>
                        </div>
                    </t>

                    <t t-if="not sale_order.is_negotiation_locked">
                        <p class="text-muted small mb-3">
                            Pitch a counter-offer or target discount directly to our commercial governance engine. Your proposal is evaluated in real time against margin constraints.
                        </p>
                        <form t-attf-action="/my/orders/#{sale_order.id}/counter_offer" method="post">
                            <input type="hidden" name="access_token" t-att-value="sale_order.access_token"/>
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light fw-semibold">Target Discount</span>
                                        <input type="number" step="0.5" min="0" max="50" name="counter_discount" class="form-control" placeholder="e.g. 15.0" required="required"/>
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-5">
                                    <input type="text" name="notes" class="form-control" placeholder="Optional comments, concession offer, or target budget..."/>
                                </div>
                                <div class="col-12 col-md-3">
                                    <button type="submit" class="btn btn-warning text-dark fw-bold w-100 shadow-sm">
                                        <i class="fa fa-paper-plane me-1"/> Submit Counter-Offer
                                    </button>
                                </div>
                            </div>
                        </form>
                    </t>
                    <t t-else="">
                        <div class="alert alert-warning mb-0 border-0" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fa fa-lock fa-2x me-3 text-warning"/>
                                <div>
                                    <h6 class="alert-heading fw-bold mb-1">Negotiation Circuit Breaker Engaged</h6>
                                    <p class="small mb-0 text-muted">
                                        Maximum permitted negotiation rounds (<t t-esc="sale_order.max_negotiation_rounds"/>) have been reached for this quotation. Terms are locked for final commercial decision. To request an exception, please contact your sales representative or sign the quotation.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-if="sale_order.last_counter_offer">
                        <div class="mt-3 p-2 bg-light rounded border small text-muted">
                            <i class="fa fa-history me-1 text-primary"/> <strong>Latest Negotiation Activity:</strong> <t t-esc="sale_order.last_counter_offer"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Prominent Centered Purple Sign Up Button on Login Page -->
    <template id="vantage_login_signup_button" inherit_id="web.login">
        <xpath expr="//form" position="after">
            <div class="container text-center my-4">
                <p class="text-muted small mb-2">Want to negotiate custom deals?</p>
                <a href="/web/signup" 
                   class="btn text-white px-4 py-2 fw-semibold rounded-3 shadow-sm"
                   style="background-color: #714B67; border: none; max-width: 260px; display: inline-block;">
                    <i class="fa fa-user-plus me-1"/> Create an Account (Sign Up)
                </a>
            </div>
        </xpath>
    </template>
</odoo>
